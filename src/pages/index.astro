      // ==========================================
      // 5. CANVAS 3D CELESTIAL SPHERE & PRETEXT
      // ==========================================
      const canvas = document.getElementById('celestial-canvas') as HTMLCanvasElement | null;
      if (!canvas) throw new Error('Canvas not found');

      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Could not get 2D context');

      // Presentation text for Pretext layout
      const BIO_PARAGRAPH = 
        "BIAJOE // CS & SYSTEMS ENGINEER. " +
        "Studente di Informatica appassionato di Intelligenza Artificiale, modelli quantizzati locali e computer graphics interattiva. " +
        "Progetto e mantengo architetture self-hosted resilienti su micro-cluster casalinghi, esplorando l'intersezione tra hardware analogico vintage e moderne tecnologie web ad alte prestazioni. " +
        "Questa plancia interattiva esegue il layout vettoriale non-DOM a 60 FPS con Pretext: muovi il cursore per guidare la Sfera Celeste e guarda il testo disporsi istantaneamente e fluidamente attorno al suo profilo.";

      const FONT_SPEC = '13px "JetBrains Mono", "Courier New", monospace';
      const LINE_HEIGHT = 20;

      // Prepare text segments once using Pretext (instant measurement)
      let preparedBio: PreparedTextWithSegments = prepareWithSegments(BIO_PARAGRAPH, FONT_SPEC);

      // Sphere physics & coordinates
      let sphereX = 0;
      let sphereY = 0;
      let targetX = 0;
      let targetY = 0;
      let rotY = 0;
      let rotX = 0.45;
      let glitchFrames = 0;

      function triggerGlitch() {
        glitchFrames = 18;
      }

      // Constellation stars data (Spherical Right Ascension [0, 2PI], Declination [-PI/2, PI/2])
      interface Star {
        ra: number;
        dec: number;
        mag: number;
        name?: string;
      }

      const STARS: Star[] = [
        // Orion
        { ra: 1.54, dec: 0.13, mag: 1.8, name: 'Betelgeuse' },
        { ra: 1.34, dec: -0.14, mag: 1.9, name: 'Rigel' },
        { ra: 1.45, dec: 0.11, mag: 1.2 },
        { ra: 1.48, dec: -0.16, mag: 1.2 },
        { ra: 1.46, dec: -0.03, mag: 1.4, name: 'Alnilam' },
        { ra: 1.44, dec: -0.01, mag: 1.3 },
        { ra: 1.48, dec: -0.05, mag: 1.3 },

        // Ursa Major (Big Dipper)
        { ra: 2.88, dec: 1.08, mag: 1.6, name: 'Dubhe' },
        { ra: 2.89, dec: 0.98, mag: 1.5, name: 'Merak' },
        { ra: 3.11, dec: 0.94, mag: 1.4 },
        { ra: 3.19, dec: 1.00, mag: 1.3 },
        { ra: 3.37, dec: 0.97, mag: 1.5, name: 'Alioth' },
        { ra: 3.51, dec: 0.96, mag: 1.6, name: 'Mizar' },
