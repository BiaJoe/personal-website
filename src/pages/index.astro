---
// src/pages/index.astro
import '../styles/global.css';
---

<!doctype html>
<html lang="it" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>BiaJoe // Hardware Console — VCR & Macintosh Classic</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=VT323&family=Silkscreen&display=swap" rel="stylesheet">
    <style>
      /* Retro scanline & screen curve effects */
      .crt-screen-container {
        position: relative;
        overflow: hidden;
      }
      .crt-screen-container::after {
        content: " ";
        display: block;
        position: absolute;
        inset: 0;
        background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
        background-size: 100% 3px, 6px 100%;
        pointer-events: none;
        z-index: 20;
      }
      .crt-glare {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 55%;
        background: linear-gradient(135deg, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0.01) 40%, transparent 60%);
        pointer-events: none;
        z-index: 21;
        border-radius: 12px 12px 0 0;
      }
      
      /* Brushed metal textures */
      .vcr-chassis {
        background: 
          linear-gradient(180deg, #2b2d34 0%, #1c1d22 35%, #15161a 70%, #202228 100%);
        box-shadow: 
          inset 0 1px 0 rgba(255, 255, 255, 0.15),
          inset 0 -2px 4px rgba(0, 0, 0, 0.8),
          0 20px 50px rgba(0, 0, 0, 0.8),
          0 0 0 1px #0a0a0c;
      }

      .mac-chassis {
        background: 
          linear-gradient(180deg, #ded8cb 0%, #cdc7b8 40%, #c4beaf 85%, #b5af9f 100%);
        box-shadow: 
          inset 0 2px 0 rgba(255, 255, 255, 0.6),
          inset 0 -3px 6px rgba(0, 0, 0, 0.25),
          0 20px 50px rgba(0, 0, 0, 0.5),
          0 0 0 1px #8c8677;
      }

      /* Radio dial ruler ticks */
      .radio-dial-scale {
        background: repeating-linear-gradient(
          to right,
          rgba(255, 255, 255, 0.5) 0px,
          rgba(255, 255, 255, 0.5) 1px,
          transparent 1px,
          transparent 8px
        );
      }
      .radio-dial-scale-mac {
        background: repeating-linear-gradient(
          to right,
          #000000 0px,
          #000000 1px,
          transparent 1px,
          transparent 8px
        );
      }

      /* Tactile 3D Buttons */
      .vcr-key {
        box-shadow: 
          0 4px 0 #0d0e10,
          0 6px 6px rgba(0, 0, 0, 0.6),
          inset 0 1px 0 rgba(255, 255, 255, 0.25);
        transition: all 0.06s ease;
      }
      .vcr-key:active {
        transform: translateY(3px);
        box-shadow: 
          0 1px 0 #0d0e10,
          0 2px 3px rgba(0, 0, 0, 0.6),
          inset 0 2px 4px rgba(0, 0, 0, 0.5);
      }

      .mac-key {
        box-shadow: 
          0 3px 0 #8e887a,
          0 4px 5px rgba(0,0,0,0.2),
          inset 0 1px 0 rgba(255,255,255,0.7);
        transition: all 0.06s ease;
      }
      .mac-key:active {
        transform: translateY(2px);
        box-shadow: 
          0 1px 0 #8e887a,
          0 1px 2px rgba(0,0,0,0.3),
          inset 0 1px 3px rgba(0,0,0,0.3);
      }

      /* Toggle switch styles */
      .toggle-switch-housing {
        box-shadow: inset 0 2px 5px rgba(0,0,0,0.7), 0 1px 0 rgba(255,255,255,0.2);
      }
      .toggle-switch-lever {
        box-shadow: 0 4px 8px rgba(0,0,0,0.5), inset 0 1px 2px rgba(255,255,255,0.8);
        transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* Custom scrollbar & font classes */
      .font-lcd {
        font-family: 'VT323', monospace;
      }
      .font-retro {
        font-family: 'Silkscreen', 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="bg-[#0f1013] text-neutral-100 min-h-screen flex flex-col justify-between p-2 sm:p-6 select-none font-mono antialiased overflow-x-hidden">

    <!-- TOP TELEMETRY STATUS -->
    <header class="max-w-6xl w-full mx-auto flex flex-wrap items-center justify-between gap-3 text-xs px-2 py-1 mb-2 text-neutral-400">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-600 animate-pulse shadow-[0_0_8px_#ef4444]"></span>
          <span class="font-bold tracking-wider text-red-500">LIVE ON HOME SERVER</span>
        </span>
        <span class="text-neutral-600 hidden sm:inline">&bull;</span>
        <span class="font-mono text-neutral-300 bg-neutral-900 border border-neutral-800 px-2 py-0.5 rounded text-[11px]" id="live-timer">
          UPTIME 00:00:00
        </span>
      </div>

      <div class="flex items-center gap-4 text-[11px]">
        <span class="text-neutral-400 hidden md:inline">SYSTEM: DUAL-ERA HARDWARE DECK</span>
        <div class="flex items-center gap-1.5 bg-neutral-900/80 border border-neutral-800 px-2 py-1 rounded">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-emerald-400 font-bold" id="telemetry-speed">TELEMETRY 60 FPS</span>
        </div>
      </div>
    </header>

    <!-- MAIN HARDWARE CONSOLE CHASSIS -->
    <main class="max-w-6xl w-full mx-auto my-auto relative">
      
      <!-- CHASSIS CONTAINER (Defaults to VCR theme, toggles to Mac Classic) -->
      <div 
        id="console-chassis" 
        class="vcr-chassis rounded-xl p-4 sm:p-7 border border-[#383a42] transition-colors duration-300 relative"
      >
        <!-- Corner Chassis Screws -->
        <div class="absolute top-2.5 left-2.5 w-2.5 h-2.5 rounded-full bg-[#111] border border-[#555] flex items-center justify-center text-[7px] text-[#777] font-sans">+</div>
        <div class="absolute top-2.5 right-2.5 w-2.5 h-2.5 rounded-full bg-[#111] border border-[#555] flex items-center justify-center text-[7px] text-[#777] font-sans">+</div>
        <div class="absolute bottom-2.5 left-2.5 w-2.5 h-2.5 rounded-full bg-[#111] border border-[#555] flex items-center justify-center text-[7px] text-[#777] font-sans">+</div>
        <div class="absolute bottom-2.5 right-2.5 w-2.5 h-2.5 rounded-full bg-[#111] border border-[#555] flex items-center justify-center text-[7px] text-[#777] font-sans">+</div>

        <!-- CONSOLE TOP BAR: Brand Badges + Physical Toggle Switch -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-black/40 pb-4 mb-5">
          
          <!-- Left Hardware Badge & Title -->
          <div class="flex items-center gap-4">
            <div id="deck-badge" class="px-2.5 py-1 bg-gradient-to-b from-[#222] to-[#111] border border-[#444] rounded text-amber-500 font-extrabold tracking-widest text-xs shadow-inner">
              <span id="badge-text">BIAJOE HR-S8000 // VCR</span>
            </div>
            
            <div class="flex items-center gap-2 text-[10px] tracking-wider text-neutral-400 uppercase font-semibold">
              <span id="badge-aux1" class="px-1.5 py-0.5 bg-neutral-800/80 border border-neutral-700/60 rounded text-neutral-300">HQ 4-HEAD</span>
              <span id="badge-aux2" class="px-1.5 py-0.5 bg-neutral-800/80 border border-neutral-700/60 rounded text-neutral-300">HI-FI STEREO</span>
              <span id="badge-aux3" class="hidden sm:inline px-1.5 py-0.5 bg-neutral-800/80 border border-neutral-700/60 rounded text-neutral-300">AUTO-TRACKING</span>
            </div>
          </div>

          <!-- Right Hardware Switch: Physical Era Toggle (VCR <-> Macintosh Classic 1984) -->
          <div class="flex items-center gap-3 bg-black/40 px-3 py-1.5 rounded-lg border border-white/10 shadow-inner">
            <span class="text-[10px] font-bold tracking-wider text-neutral-400" id="label-mode-vcr">80s VCR</span>
            
            <!-- Mechanical Toggle Button -->
            <button 
              id="era-toggle-btn" 
              type="button" 
              aria-label="Toggle Hardware Theme between VCR and Macintosh Classic"
              class="w-14 h-7 rounded-full bg-[#1a1b1e] border-2 border-[#555] p-0.5 relative cursor-pointer toggle-switch-housing focus:outline-hidden"
            >
              <div 
                id="toggle-lever" 
                class="w-5 h-5 rounded-full bg-gradient-to-b from-[#eee] to-[#999] toggle-switch-lever transform translate-x-0"
              ></div>
            </button>

            <span class="text-[10px] font-bold tracking-wider text-neutral-400" id="label-mode-mac">MAC 1984</span>
          </div>

        </div>

        <!-- MAIN DECK GRID: Central CRT Screen + Right Hardware Bay -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
          
          <!-- CENTRAL CRT MONITOR DISPLAY (Cols 1-8 / 9) -->
          <div class="lg:col-span-8 flex flex-col">
            <!-- CRT Outer Bezel -->
            <div 
              id="crt-bezel" 
              class="p-3 sm:p-4 rounded-xl bg-[#0f1012] border-4 border-[#2c2d33] shadow-[inset_0_4px_12px_rgba(0,0,0,0.9),0_4px_10px_rgba(0,0,0,0.5)] flex-1 flex flex-col"
            >
              <!-- CRT Header Status Line inside screen -->
              <div class="flex justify-between items-center px-2 py-1 mb-2 font-mono text-[11px] border-b border-white/10 text-emerald-400" id="crt-status-header">
                <div class="flex items-center gap-2">
                  <span class="animate-pulse">▶</span>
                  <span class="font-bold tracking-wider" id="crt-station-label">CH 03: CELESTIAL TELEMETRY</span>
                </div>
                <div class="flex items-center gap-3 font-lcd text-sm">
                  <span id="crt-sp-indicator">SP TAPE 02</span>
                  <span class="text-neutral-400" id="crt-vcr-time">TC 00:24:18</span>
                </div>
              </div>

              <!-- High-DPI Responsive Canvas Container with CRT Scanlines overlay -->
              <div class="crt-screen-container relative flex-1 min-h-[360px] sm:min-h-[440px] rounded-lg bg-[#070b09] border border-white/5 flex items-center justify-center">
                <div class="crt-glare"></div>
                <canvas 
                  id="celestial-canvas" 
                  class="w-full h-full block cursor-crosshair relative z-10"
                ></canvas>
              </div>

              <!-- CRT Sub-footer inside bezel -->
              <div class="flex justify-between items-center px-2 pt-2 text-[10px] text-neutral-400 font-mono" id="crt-footer-info">
                <span>WIRE: 3D CELESTIAL SPHERE + PRETEXT 60 FPS</span>
                <span class="hidden sm:inline">DRAG OR HOVER CURSOR TO WRAP TEXT</span>
              </div>
            </div>
          </div>

          <!-- RIGHT BAY: Cassette Flap, FM Radio Tuner, Audio Meters & Controls -->
          <div class="lg:col-span-4 flex flex-col justify-between gap-4">
            
            <!-- CASSETTE / FLOPPY DRIVE COMPARTMENT -->
            <div 
              id="media-bay" 
              class="p-3 bg-[#131417] border-2 border-[#2a2c33] rounded-lg shadow-inner flex flex-col justify-between"
            >
              <div class="flex justify-between items-center mb-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400" id="media-slot-title">CASSETTE COMPARTMENT</span>
                <span class="text-[9px] bg-red-950/80 text-red-400 border border-red-800/60 px-1.5 py-0.2 rounded font-bold" id="media-status-badge">REC INHIBIT</span>
              </div>

              <!-- Cassette Window with Rotating Spools -->
              <div 
                id="cassette-window" 
                class="h-16 sm:h-20 bg-black/60 rounded border border-[#333] relative flex items-center justify-around px-4 overflow-hidden"
              >
                <!-- Left Spool -->
                <div class="w-10 h-10 rounded-full border-2 border-[#555] bg-neutral-900 flex items-center justify-center relative animate-[spin_10s_linear_infinite]">
                  <div class="w-3 h-3 rounded-full bg-neutral-700"></div>
                  <div class="absolute w-1 h-8 bg-neutral-600/40 rounded-sm"></div>
                  <div class="absolute w-8 h-1 bg-neutral-600/40 rounded-sm"></div>
                </div>

                <!-- Cassette Center Tape Label -->
                <div class="text-center font-mono z-10">
                  <div class="text-[10px] font-bold text-amber-400 tracking-wider">E-180 PRO MASTER</div>
                  <div class="text-[9px] text-neutral-400">BIAS: HIGH // 70µs</div>
                </div>

                <!-- Right Spool -->
                <div class="w-10 h-10 rounded-full border-2 border-[#555] bg-neutral-900 flex items-center justify-center relative animate-[spin_10s_linear_infinite]">
                  <div class="w-3 h-3 rounded-full bg-neutral-700"></div>
                  <div class="absolute w-1 h-8 bg-neutral-600/40 rounded-sm"></div>
                  <div class="absolute w-8 h-1 bg-neutral-600/40 rounded-sm"></div>
                </div>
              </div>
            </div>

            <!-- FM RADIO TUNER (88.0 MHz - 108.0 MHz) -->
            <div 
              id="fm-tuner-bay" 
              class="p-3 bg-[#131417] border-2 border-[#2a2c33] rounded-lg shadow-inner flex flex-col gap-2"
            >
              <div class="flex justify-between items-center">
                <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400" id="tuner-title">FM TUNER / TELEMETRY</span>
                <span class="font-lcd text-lg text-emerald-400 bg-black/80 px-2 py-0.5 rounded border border-emerald-900/60" id="freq-readout">
                  98.5 MHz
                </span>
              </div>

              <!-- Illuminated Radio Scale with Draggable / Clickable Slider -->
              <div class="relative py-2">
                <div 
                  id="radio-scale-bg" 
                  class="h-9 rounded bg-[#1c241e] border border-emerald-900/40 relative overflow-hidden flex items-center shadow-inner cursor-pointer"
                >
                  <!-- Dial scale markings -->
                  <div class="w-full h-4 radio-dial-scale opacity-60"></div>

                  <!-- Frequency Numbers Overlay -->
                  <div class="absolute inset-0 flex justify-between items-end px-2 pb-1 text-[9px] font-mono text-emerald-400/80 font-bold pointer-events-none">
                    <span>88</span>
                    <span>92</span>
                    <span>96</span>
                    <span>100</span>
                    <span>104</span>
                    <span>108</span>
                  </div>

                  <!-- Tuner Indicator Needle (Red Needle) -->
                  <div 
                    id="tuner-needle" 
                    class="absolute top-0 bottom-0 w-1 bg-red-500 shadow-[0_0_6px_#ef4444] pointer-events-none z-10 transition-all duration-75"
                    style="left: 52.5%;"
                  >
                    <div class="w-2.5 h-1.5 bg-red-600 -translate-x-[3px] rounded-b-xs"></div>
                  </div>
                </div>

                <!-- Input range overlay for clean dragging & keyboard accessibility -->
                <input 
                  type="range" 
                  id="radio-slider" 
                  min="88.0" 
                  max="108.0" 
                  step="0.1" 
                  value="98.5" 
                  aria-label="FM Radio Frequency Tuner"
                  class="w-full absolute inset-0 opacity-0 cursor-pointer h-full z-20"
                />
              </div>

              <!-- Channel Preset Name -->
              <div class="flex justify-between items-center text-[10px] text-neutral-400 font-mono">
                <span id="station-name" class="text-amber-400 font-semibold truncate">STATION: ORION CELESTIAL BEACON</span>
                <span id="stereo-indicator" class="text-red-500 font-bold text-[9px] animate-pulse">● STEREO</span>
              </div>
            </div>

            <!-- AUDIO VU LEVEL METERS -->
            <div id="vu-bay" class="p-2.5 bg-[#131417] border border-[#262830] rounded-lg">
              <div class="flex justify-between text-[9px] text-neutral-400 font-mono mb-1 font-bold">
                <span>AUDIO CH-1</span>
                <span>CH-2</span>
              </div>
              <div class="space-y-1">
                <div class="h-2 bg-neutral-900 rounded-xs flex overflow-hidden border border-neutral-800 gap-0.5 p-0.5">
                  <div class="h-full bg-emerald-500 rounded-xs w-3/4 animate-pulse"></div>
                  <div class="h-full bg-amber-500 rounded-xs w-1/6"></div>
                  <div class="h-full bg-red-500 rounded-xs w-1/12 opacity-40"></div>
                </div>
                <div class="h-2 bg-neutral-900 rounded-xs flex overflow-hidden border border-neutral-800 gap-0.5 p-0.5">
                  <div class="h-full bg-emerald-500 rounded-xs w-2/3 animate-pulse"></div>
                  <div class="h-full bg-amber-500 rounded-xs w-1/5"></div>
                  <div class="h-full bg-red-500 rounded-xs w-1/12 opacity-20"></div>
                </div>
              </div>
            </div>

            <!-- MECHANICAL VCR BUTTONS -->
            <div class="grid grid-cols-2 gap-2.5">
              
              <!-- PLAY BIO BUTTON -->
              <button 
                id="btn-play-bio" 
                type="button"
                class="vcr-key bg-gradient-to-b from-[#3a3d46] to-[#202227] text-white p-2.5 rounded-md font-bold text-xs uppercase tracking-wider border border-[#555] flex items-center justify-center gap-1.5 cursor-pointer"
              >
                <span class="text-emerald-400">▶</span>
                <span class="btn-label">PLAY BIO</span>
              </button>

              <!-- MUTE AUDIO BUTTON -->
              <button 
                id="btn-mute" 
                type="button"
                class="vcr-key bg-gradient-to-b from-[#3a3d46] to-[#202227] text-white p-2.5 rounded-md font-bold text-xs uppercase tracking-wider border border-[#555] flex items-center justify-center gap-1.5 cursor-pointer"
              >
                <span id="mute-icon" class="text-amber-400">🔊</span>
                <span id="mute-label" class="btn-label">AUDIO ON</span>
              </button>

              <!-- CV [TAPE 1] LINK BUTTON -->
              <a 
                id="btn-tape1"
                href="/cv" 
                class="vcr-key bg-gradient-to-b from-[#3a3d46] to-[#202227] text-white p-2.5 rounded-md font-bold text-xs uppercase tracking-wider border border-[#555] flex items-center justify-center gap-1.5 cursor-pointer text-center no-underline"
              >
                <span class="text-cyan-400">📼</span>
                <span class="btn-label">CV [TAPE 1]</span>
              </a>

              <!-- PROJECTS [TAPE 2] LINK BUTTON -->
              <a 
                id="btn-tape2"
                href="/projects" 
                class="vcr-key bg-gradient-to-b from-[#3a3d46] to-[#202227] text-white p-2.5 rounded-md font-bold text-xs uppercase tracking-wider border border-[#555] flex items-center justify-center gap-1.5 cursor-pointer text-center no-underline"
              >
                <span class="text-purple-400">💾</span>
                <span class="btn-label">PROJECTS [TAPE 2]</span>
              </a>

            </div>

          </div>

        </div>

        <!-- FOOTER EMBOSSED LOGO & STATUS -->
        <div class="mt-5 pt-3 border-t border-black/40 flex flex-wrap justify-between items-center text-[10px] text-neutral-400 font-mono">
          <div class="flex items-center gap-2">
            <span class="text-neutral-300 font-bold" id="brand-tagline">NIPPON VIDEO CORP. // AUTOMATED VECTOR GRAPHICS</span>
            <span class="text-neutral-500 hidden sm:inline">&bull; SER. NO. 84-4096-TK</span>
          </div>
          <div>
            <span id="theme-era-name" class="font-bold text-neutral-300">SYSTEM: 1980s VCR CONSOLE</span>
          </div>
        </div>

      </div>

    </main>

    <!-- FOOTER NAV & GITHUB LINK -->
    <footer class="max-w-6xl w-full mx-auto text-center text-xs text-neutral-400 py-2 font-mono flex flex-wrap justify-between items-center gap-2">
      <div>
        Built with <a href="https://astro.build" class="underline hover:text-white" target="_blank">Astro</a> &bull; Dynamic Text Wrap via <code class="text-neutral-300">@chenglou/pretext</code>
      </div>
      <div>
        Source: <a href="https://github.com/BiaJoe/personal-website" class="underline hover:text-white" target="_blank">github.com/BiaJoe/personal-website</a>
      </div>
    </footer>

    <!-- CLIENT LOGIC: Canvas 3D Celestial Sphere + Pretext + Web Audio + Themes -->
    <script>
      import { prepareWithSegments, layoutNextLine, type LayoutCursor, type PreparedTextWithSegments } from '@chenglou/pretext';

      // ==========================================
      // 1. WEB AUDIO API MECHANICAL CLICK ENGINE
      // ==========================================
      let audioCtx: AudioContext | null = null;
      let isAudioMuted = false;

      function getAudioContext(): AudioContext | null {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
          if (AudioContextClass) {
            audioCtx = new AudioContextClass();
          }
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        return audioCtx;
      }

      function playSound(type: 'click' | 'toggle' | 'tune' | 'glitch' = 'click') {
        if (isAudioMuted) return;
        const ctx = getAudioContext();
        if (!ctx) return;

        try {
          const now = ctx.currentTime;

          if (type === 'tune') {
            // Subtle high-frequency needle tick
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(600 + Math.random() * 400, now);
            gain.gain.setValueAtTime(0.02, now);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.012);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(now);
            osc.stop(now + 0.015);
            return;
          }

          if (type === 'glitch') {
            // Static noise burst
            const bufferSize = Math.floor(ctx.sampleRate * 0.04);
            const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
            const noise = ctx.createBufferSource();
            noise.buffer = buffer;
            const filter = ctx.createBiquadFilter();
            filter.type = 'bandpass';
            filter.frequency.value = 1400;
            const gain = ctx.createGain();
            gain.gain.setValueAtTime(0.06, now);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.04);
            noise.connect(filter);
            filter.connect(gain);
            gain.connect(ctx.destination);
            noise.start(now);
            return;
          }

          // Mechanical solenoid / spring switch click
          // Component 1: Thump
          const osc = ctx.createOscillator();
          const oscGain = ctx.createGain();
          const startFreq = type === 'toggle' ? 260 : 190;
          osc.frequency.setValueAtTime(startFreq, now);
          osc.frequency.exponentialRampToValueAtTime(40, now + 0.035);
          oscGain.gain.setValueAtTime(0.09, now);
          oscGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.04);
          osc.connect(oscGain);
          oscGain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 0.04);

          // Component 2: High tactile noise snap
          const bufSize = Math.floor(ctx.sampleRate * 0.025);
          const noiseBuf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
          const chData = noiseBuf.getChannelData(0);
          for (let i = 0; i < bufSize; i++) chData[i] = Math.random() * 2 - 1;
          const noiseSrc = ctx.createBufferSource();
          noiseSrc.buffer = noiseBuf;

          const bp = ctx.createBiquadFilter();
          bp.type = 'bandpass';
          bp.frequency.value = type === 'toggle' ? 3400 : 2200;
          bp.Q.value = 3.5;

          const noiseGain = ctx.createGain();
          noiseGain.gain.setValueAtTime(0.08, now);
          noiseGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.025);

          noiseSrc.connect(bp);
          bp.connect(noiseGain);
          noiseGain.connect(ctx.destination);
          noiseSrc.start(now);
        } catch {
