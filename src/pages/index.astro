        // Cassiopeia
        { ra: 0.15, dec: 1.03, mag: 1.7, name: 'Schedar' },
        { ra: 0.05, dec: 1.02, mag: 1.5 },
        { ra: 0.24, dec: 1.06, mag: 1.8 },
        { ra: 0.35, dec: 1.05, mag: 1.4 },
        { ra: 0.46, dec: 1.11, mag: 1.5 },

        // Polaris (North Star)
        { ra: 0.66, dec: 1.55, mag: 2.0, name: 'Polaris' },

        // Cygnus (Northern Cross)
        { ra: 5.41, dec: 0.79, mag: 1.8, name: 'Deneb' },
        { ra: 5.12, dec: 0.49, mag: 1.4, name: 'Albireo' },
        { ra: 5.34, dec: 0.70, mag: 1.5 },
        { ra: 5.46, dec: 0.88, mag: 1.4 },
        { ra: 5.22, dec: 0.58, mag: 1.3 },
      ];

      // Constellation connector lines (pairs of star indices)
      const CONSTELLATION_LINES: [number, number][] = [
        // Orion
        [0, 2], [2, 5], [5, 4], [4, 6], [6, 3], [3, 1], [0, 4],
        // Big Dipper
        [7, 8], [8, 9], [9, 10], [10, 7], [10, 11], [11, 12], [12, 13],
        // Cassiopeia
        [14, 15], [14, 16], [16, 17], [17, 18],
        // Cygnus
        [20, 22], [22, 21], [22, 23], [22, 24]
      ];

      // High-DPI Canvas Resizing
      let displayW = 0;
      let displayH = 0;

      function resizeCanvas() {
        if (!canvas) return;
        const rect = canvas.getBoundingClientRect();
        const dpr = Math.max(1, window.devicePixelRatio || 1);
        displayW = rect.width;
        displayH = rect.height;

        canvas.width = Math.floor(displayW * dpr);
        canvas.height = Math.floor(displayH * dpr);

        if (ctx) {
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        // Set default sphere target on right side
        if (targetX === 0 && targetY === 0) {
          targetX = displayW * 0.70;
          targetY = displayH * 0.50;
          sphereX = targetX;
          sphereY = targetY;
        }
      }

      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();

      // Mouse tracking on Canvas
      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
      });

      canvas.addEventListener('mouseleave', () => {
        // Return sphere smoothly to resting coordinate
        targetX = displayW * 0.70;
        targetY = displayH * 0.50;
      });

      // Touch tracking
      canvas.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          const rect = canvas.getBoundingClientRect();
          targetX = e.touches[0].clientX - rect.left;
          targetY = e.touches[0].clientY - rect.top;
        }
      }, { passive: true });

      // 3D Math Helper: project (x, y, z) with rotation
      function projectPoint(x: number, y: number, z: number, rX: number, rY: number) {
        // Rotate around Y
        const cosY = Math.cos(rY);
        const sinY = Math.sin(rY);
        const x1 = x * cosY + z * sinY;
        const z1 = -x * sinY + z * cosY;

        // Rotate around X
        const cosX = Math.cos(rX);
        const sinX = Math.sin(rX);
        const y2 = y * cosX - z1 * sinX;
        const z2 = y * sinX + z1 * cosX;

        return { x: x1, y: y2, z: z2 };
      }

      // Convert spherical coord (ra, dec, radius) to Cartesian
      function sphericalToCartesian(ra: number, dec: number, r: number) {
        return {
          x: r * Math.cos(dec) * Math.cos(ra),
          y: r * Math.sin(dec),
          z: r * Math.cos(dec) * Math.sin(ra)
        };
      }

      // ==========================================
      // 6. MAIN 60 FPS ANIMATION & RENDER LOOP
      // ==========================================
      function renderFrame() {
        if (!ctx || !canvas) return;

        // Modulate sphere properties from FM radio slider
        const freqDelta = currentFreq - 88.0; // 0.0 to 20.0
        const speedMultiplier = 0.005 + (freqDelta / 20.0) * 0.015;
        const sphereBaseRadius = Math.min(displayW, displayH) * 0.26;
        const radiusZoom = 0.85 + (freqDelta / 20.0) * 0.35;
        const sphereRadius = sphereBaseRadius * radiusZoom;

        rotY += speedMultiplier;

        // Lerp sphere coordinates smoothly towards target cursor
        sphereX += (targetX - sphereX) * 0.08;
        sphereY += (targetY - sphereY) * 0.08;

        // Clamp sphere inside visible canvas boundaries
        const boundPadding = sphereRadius + 15;
        sphereX = Math.max(boundPadding, Math.min(displayW - boundPadding, sphereX));
        sphereY = Math.max(boundPadding, Math.min(displayH - boundPadding, sphereY));

        const isMac = currentEra === 'mac';

        // 1. Clear background
        ctx.save();
        if (isMac) {
          // 1984 Macintosh Classic Monochrome LCD / Paper White
          ctx.fillStyle = '#f3f0e8';
          ctx.fillRect(0, 0, displayW, displayH);

          // Subtle 1-bit stipple / dither grid
          ctx.fillStyle = 'rgba(0, 0, 0, 0.03)';
          for (let py = 0; py < displayH; py += 3) {
            for (let px = (py % 6 === 0 ? 0 : 2); px < displayW; px += 4) {
              ctx.fillRect(px, py, 1, 1);
            }
          }
        } else {
          // 80s VCR Dark Phosphor Display
          ctx.fillStyle = '#060a08';
          ctx.fillRect(0, 0, displayW, displayH);

          // Phosphor radial ambient glow behind sphere
          const radial = ctx.createRadialGradient(
            sphereX, sphereY, 5,
            sphereX, sphereY, sphereRadius * 1.6
          );
          radial.addColorStop(0, 'rgba(40, 220, 120, 0.12)');
          radial.addColorStop(0.6, 'rgba(20, 100, 60, 0.04)');
          radial.addColorStop(1, 'transparent');
          ctx.fillStyle = radial;
          ctx.fillRect(0, 0, displayW, displayH);
        }

        // CRT Glitch tracking jitter effect
        if (glitchFrames > 0) {
          glitchFrames--;
          const jitterY = (Math.random() - 0.5) * 8;
          ctx.translate(0, jitterY);

          // Glitch scanlines
          ctx.fillStyle = isMac ? 'rgba(0,0,0,0.1)' : 'rgba(80,255,140,0.2)';
          ctx.fillRect(0, Math.random() * displayH, displayW, 6);
        }

        // ==========================================
        // 2. RENDER 3D CELESTIAL SPHERE WIREFRAME
        // ==========================================
        const sphereColorFront = isMac ? '#000000' : 'rgba(80, 255, 140, 0.85)';
        const sphereColorBack = isMac ? 'rgba(0, 0, 0, 0.22)' : 'rgba(30, 140, 70, 0.35)';
        const eclipticColor = isMac ? '#000000' : 'rgba(255, 190, 40, 0.9)';
        const starColor = isMac ? '#000000' : '#ffffff';

        // Outer Sphere Rim
        ctx.beginPath();
        ctx.arc(sphereX, sphereY, sphereRadius, 0, Math.PI * 2);
        ctx.strokeStyle = isMac ? '#000000' : 'rgba(80, 255, 140, 0.9)';
        ctx.lineWidth = isMac ? 1.5 : 1.2;
        ctx.stroke();

        // Parallels (Latitude Rings)
        const latitudes = [-1.047, -0.523, 0, 0.523, 1.047]; // -60°, -30°, 0° (Equator), 30°, 60°
        latitudes.forEach(lat => {
          const rRing = sphereRadius * Math.cos(lat);
          const yRing = sphereRadius * Math.sin(lat);
          const isEquator = lat === 0;

          const segments = 36;
          for (let i = 0; i < segments; i++) {
            const a1 = (i / segments) * Math.PI * 2;
            const a2 = ((i + 1) / segments) * Math.PI * 2;

            const p1 = projectPoint(rRing * Math.cos(a1), yRing, rRing * Math.sin(a1), rotX, rotY);
            const p2 = projectPoint(rRing * Math.cos(a2), yRing, rRing * Math.sin(a2), rotX, rotY);

            const isFront = (p1.z + p2.z) / 2 > 0;

            ctx.beginPath();
            ctx.moveTo(sphereX + p1.x, sphereY - p1.y);
            ctx.lineTo(sphereX + p2.x, sphereY - p2.y);
            ctx.strokeStyle = isFront ? sphereColorFront : sphereColorBack;
            ctx.lineWidth = isEquator ? (isFront ? 1.6 : 0.9) : (isFront ? 1.0 : 0.6);
            if (!isFront && !isMac) ctx.setLineDash([2, 3]);
            else ctx.setLineDash([]);
            ctx.stroke();
          }
        });

        // Meridians (Longitude lines)
        const meridianCount = 8;
        for (let m = 0; m < meridianCount; m++) {
          const phi = (m / meridianCount) * Math.PI;
          const segments = 40;
          for (let i = 0; i < segments; i++) {
            const t1 = (i / segments) * Math.PI * 2;
            const t2 = ((i + 1) / segments) * Math.PI * 2;

            const x1 = sphereRadius * Math.cos(t1) * Math.cos(phi);
            const y1 = sphereRadius * Math.sin(t1);
            const z1 = sphereRadius * Math.cos(t1) * Math.sin(phi);

            const x2 = sphereRadius * Math.cos(t2) * Math.cos(phi);
            const y2 = sphereRadius * Math.sin(t2);
            const z2 = sphereRadius * Math.cos(t2) * Math.sin(phi);

            const p1 = projectPoint(x1, y1, z1, rotX, rotY);
            const p2 = projectPoint(x2, y2, z2, rotX, rotY);

            const isFront = (p1.z + p2.z) / 2 > 0;

            ctx.beginPath();
            ctx.moveTo(sphereX + p1.x, sphereY - p1.y);
            ctx.lineTo(sphereX + p2.x, sphereY - p2.y);
            ctx.strokeStyle = isFront ? sphereColorFront : sphereColorBack;
            ctx.lineWidth = isFront ? 0.9 : 0.5;
            if (!isFront && !isMac) ctx.setLineDash([1, 3]);
            else ctx.setLineDash([]);
            ctx.stroke();
          }
        }
        ctx.setLineDash([]);

        // Ecliptic Ring (Tilted at 23.44°)
        const eclipticObliquity = 0.409;
        const eclipticSteps = 48;
        for (let i = 0; i < eclipticSteps; i++) {
          const a1 = (i / eclipticSteps) * Math.PI * 2;
          const a2 = ((i + 1) / eclipticSteps) * Math.PI * 2;

          const p1Raw = {
            x: sphereRadius * Math.cos(a1),
            y: sphereRadius * Math.sin(a1) * Math.sin(eclipticObliquity),
            z: sphereRadius * Math.sin(a1) * Math.cos(eclipticObliquity)
          };
          const p2Raw = {
            x: sphereRadius * Math.cos(a2),
            y: sphereRadius * Math.sin(a2) * Math.sin(eclipticObliquity),
            z: sphereRadius * Math.sin(a2) * Math.cos(eclipticObliquity)
          };

          const p1 = projectPoint(p1Raw.x, p1Raw.y, p1Raw.z, rotX, rotY);
          const p2 = projectPoint(p2Raw.x, p2Raw.y, p2Raw.z, rotX, rotY);

          if ((p1.z + p2.z) / 2 > 0) {
            ctx.beginPath();
            ctx.moveTo(sphereX + p1.x, sphereY - p1.y);
            ctx.lineTo(sphereX + p2.x, sphereY - p2.y);
            ctx.strokeStyle = eclipticColor;
            ctx.lineWidth = 1.4;
            ctx.stroke();
          }
        }

        // Project Stars
        const projectedStars = STARS.map(s => {
          const cart = sphericalToCartesian(s.ra, s.dec, sphereRadius * 0.98);
          const proj = projectPoint(cart.x, cart.y, cart.z, rotX, rotY);
          return { ...s, proj };
        });

        // Draw Constellation Lines (Front Hemisphere)
        CONSTELLATION_LINES.forEach(([i1, i2]) => {
          const s1 = projectedStars[i1];
          const s2 = projectedStars[i2];
          if (s1 && s2 && s1.proj.z > -sphereRadius * 0.2 && s2.proj.z > -sphereRadius * 0.2) {
            ctx.beginPath();
            ctx.moveTo(sphereX + s1.proj.x, sphereY - s1.proj.y);
            ctx.lineTo(sphereX + s2.proj.x, sphereY - s2.proj.y);
            ctx.strokeStyle = isMac ? 'rgba(0,0,0,0.45)' : 'rgba(120, 220, 255, 0.45)';
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        });

        // Draw Stars & Labels
        projectedStars.forEach(s => {
          if (s.proj.z > 0) {
            const starRadius = isMac ? (s.mag > 1.6 ? 2.5 : 1.8) : (s.mag > 1.6 ? 2.8 : 2.0);
            ctx.beginPath();
            ctx.arc(sphereX + s.proj.x, sphereY - s.proj.y, starRadius, 0, Math.PI * 2);
            ctx.fillStyle = starColor;
            ctx.fill();

            // Star Name
            if (s.name && s.proj.z > sphereRadius * 0.25) {
              ctx.font = '9px "JetBrains Mono", monospace';
              ctx.fillStyle = isMac ? 'rgba(0,0,0,0.6)' : 'rgba(120, 255, 180, 0.7)';
              ctx.fillText(s.name, sphereX + s.proj.x + 4, sphereY - s.proj.y - 2);
            }
          }
        });

        // ==========================================
        // 3. DYNAMIC TEXT WRAP AROUND SPHERE VIA PRETEXT
        // ==========================================
        ctx.font = FONT_SPEC;
        ctx.fillStyle = isMac ? '#000000' : '#4ade80';

        let cursor: LayoutCursor = { segmentIndex: 0, graphemeIndex: 0 };
        const padX = 22;
        const padY = 32;
        let lineY = padY;
        const rEff = sphereRadius + 18; // Safety boundary around celestial sphere

        while (lineY < displayH - 16) {
          const dy = Math.abs(lineY - sphereY);
          let startX = padX;
          let availWidth = displayW - padX * 2;

          if (dy < rEff) {
            // Row intersects sphere obstacle
            const dx = Math.sqrt(rEff * rEff - dy * dy);
            const obstacleLeft = sphereX - dx;
            const obstacleRight = sphereX + dx;

            const roomLeft = obstacleLeft - padX;
            const roomRight = displayW - padX - obstacleRight;

            // Route text to side with adequate space
            if (sphereX >= displayW / 2) {
              // Sphere is on the right/center: text routes to left
              if (roomLeft > 85) {
                startX = padX;
                availWidth = roomLeft - 10;
              } else if (roomRight > 85) {
                startX = obstacleRight + 12;
                availWidth = roomRight - 10;
              } else {
                // Sphere occupies nearly entire width on this row
                lineY += LINE_HEIGHT;
                continue;
              }
            } else {
              // Sphere is on the left: text routes to right
              if (roomRight > 85) {
                startX = obstacleRight + 12;
                availWidth = roomRight - 10;
              } else if (roomLeft > 85) {
                startX = padX;
                availWidth = roomLeft - 10;
              } else {
                lineY += LINE_HEIGHT;
                continue;
              }
            }
          }

          if (availWidth < 60) {
            lineY += LINE_HEIGHT;
            continue;
          }

          // Pretext layout calculation: zero DOM reflow, microsecond speed!
          const line = layoutNextLine(preparedBio, Math.floor(availWidth), cursor);
          if (!line) {
            break; // All text laid out
          }

          // Render text line onto canvas
          ctx.fillText(line.text, startX, lineY);
          cursor = line.end;
          lineY += LINE_HEIGHT;
        }

        ctx.restore();
        requestAnimationFrame(renderFrame);
      }

      // Start 60 FPS Canvas loop
      requestAnimationFrame(renderFrame);

    </script>
  </body>
</html>
